{
  "schema": "optiak-product-engineering-operating-model/v1",
  "version": "1.2.0",
  "reviewedAt": "2026-09-20",
  "status": "offline_defined_no_runtime_authority",
  "humanConflictOwner": "board",
  "principles": {
    "oneAgentPerDomainRequired": false,
    "boardMayAssignSpecialistsDirectly": true,
    "authorMayApproveOwnChange": false,
    "domainOwnershipCreatesEvidenceAuthority": false,
    "successfulGateAuthorizesRelease": false,
    "exactlyOneLeadPerQuestion": true,
    "maximumConsultedAgents": 2,
    "oneCanonicalReportPerDecision": true,
    "contributorsReturnDeltaOnly": true,
    "freshAcceptedEvidenceIsReused": true,
    "consultationsHaveDistinctQuestions": true,
    "allCurrentAgentsHaveDistinctLeadClasses": true
  },
  "engagementModel": {
    "contract": "skills/optiak-change-control/references/engineering-engagement-contract.json",
    "defaultPattern": "on_demand_single_lead",
    "pipelineStagesAreConditional": true,
    "blanketFanoutAllowed": false,
    "skipUnneededStagesWithReason": true,
    "assuranceConsumesEvidenceByReference": true
  },
  "domains": [
    {
      "id": "4.1",
      "slug": "product-management-strategy",
      "name": "Product Management & Strategy",
      "accountable": "product-prd-lead",
      "responsible": ["product-prd-lead", "brand-ui-quality-reviewer", "documentation-dx-steward"],
      "reviewers": ["qa-e2e-validation-engineer"],
      "staffingStatus": "covered",
      "scope": ["product_vision_strategy", "roadmap_goals", "discovery_customer_insights", "prds_product_specs", "product_decisions"]
    },
    {
      "id": "4.2",
      "slug": "core-product-platform",
      "name": "Core Product Platform",
      "accountable": "engineering-assurance-lead",
      "responsible": ["principal-platform-architect", "senior-platform-engineer"],
      "reviewers": ["independent-code-reviewer", "qa-e2e-validation-engineer"],
      "staffingStatus": "covered",
      "scope": ["gateway_apis", "governance_guardrails", "routing_optimization", "context_memory", "customer_observability_analytics", "core_platform_architecture"]
    },
    {
      "id": "4.3",
      "slug": "integrations-enterprise",
      "name": "Integrations & Enterprise",
      "accountable": "engineering-assurance-lead",
      "responsible": ["principal-platform-architect", "senior-platform-engineer"],
      "reviewers": ["independent-code-reviewer", "qa-e2e-validation-engineer"],
      "staffingStatus": "temporary_coverage",
      "scope": ["data_integrations_connectors", "tools_mcp", "identity_permissions_delegation", "byo_providers_models", "enterprise_capabilities"]
    },
    {
      "id": "4.4",
      "slug": "data-platform-ai-quality",
      "name": "Data Platform & AI Quality",
      "accountable": "engineering-assurance-lead",
      "responsible": ["principal-platform-architect", "qa-e2e-validation-engineer"],
      "reviewers": ["independent-code-reviewer", "reliability-incident-engineer"],
      "staffingStatus": "temporary_coverage_explicit_gap",
      "candidateFutureRole": "data-platform-ai-quality-engineer",
      "scope": ["event_data_models", "analytics_data_platform", "data_pipelines_transformations", "evals_benchmarks", "experiments_ml_pipelines"]
    },
    {
      "id": "4.5",
      "slug": "infrastructure-reliability",
      "name": "Infrastructure & Reliability",
      "accountable": "engineering-assurance-lead",
      "responsible": ["reliability-incident-engineer", "senior-platform-engineer"],
      "reviewers": ["independent-code-reviewer", "qa-e2e-validation-engineer"],
      "staffingStatus": "covered",
      "scope": ["cloud_aws", "iac", "environments", "ci_cd", "reliability_sre", "performance_capacity", "incidents_postmortems", "security_engineering"]
    },
    {
      "id": "4.6",
      "slug": "engineering-handbook",
      "name": "Engineering Handbook",
      "accountable": "engineering-assurance-lead",
      "responsible": ["documentation-dx-steward"],
      "reviewers": ["independent-code-reviewer"],
      "staffingStatus": "covered_by_chapter_owners",
      "scope": ["architecture_principles", "adr_rfc_process", "development_standards", "testing_strategy", "release_process", "engineering_ways_of_working"]
    }
  ],
  "deliveryPipeline": [
    {"id": "product_intent_and_prd", "owner": "product-prd-lead", "requiredWhen": "product behavior, priority or acceptance criteria change"},
    {"id": "architecture_review", "owner": "principal-platform-architect", "requiredWhen": "a structural decision or cross-boundary tradeoff exists"},
    {"id": "domain_implementation", "owner": "senior-platform-engineer", "requiredWhen": "an approved change or implementation diagnosis is requested"},
    {"id": "independent_change_review", "owner": "independent-code-reviewer", "requiredWhen": "source or infrastructure code changes"},
    {"id": "functional_validation", "owner": "qa-e2e-validation-engineer", "requiredWhen": "observable behavior, permissions, regression or evaluation quality changes"},
    {"id": "ui_quality_review", "owner": "brand-ui-quality-reviewer", "requiredWhen": "a user-facing visual or interaction surface changes"},
    {"id": "documentation_dx_review", "owner": "documentation-dx-steward", "requiredWhen": "a public claim, example, navigation path or handbook record changes"},
    {"id": "runtime_reliability_review", "owner": "reliability-incident-engineer", "requiredWhen": "runtime risk, SLO, capacity, rollout or incident learning changes"},
    {"id": "release_readiness", "owner": "engineering-assurance-lead", "requiredWhen": "the Board is considering advancement or release"},
    {"id": "human_release_decision", "owner": "board"},
    {"id": "measurement_learning", "owner": "product-prd-lead", "requiredWhen": "an approved product outcome has measurable post-change evidence"}
  ],
  "agentCreationGates": [
    "recurring_queue_observed",
    "stable_authoritative_source",
    "bounded_testable_deliverable",
    "distinct_tools_permissions_context_or_independence",
    "explicit_reporting_handoffs_review_budget_escalation",
    "fixture_smoke_and_paused_import",
    "measured_bottleneck_or_control_risk"
  ]
}
