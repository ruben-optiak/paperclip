  "status": "offline_defined_sources_not_assumed_connected",
  "humanConflictOwner": "board",
  "globalPolicy": {
    "defaultDecision": "blocked_on_authority",
    "missingEvidence": "unknown",
    "staleEvidence": "unknown",
    "publicDocsProveImplementation": false,
    "sourceCodeProvesDeployment": false,
    "healthEndpointProvesReadiness": false,
    "fixtureProvesLiveBehavior": false,
    "architectureReviewerMayCreateProductIntent": false,
    "architectureReviewerMayApproveOwnImplementation": false
  },
  "sourceClasses": [
