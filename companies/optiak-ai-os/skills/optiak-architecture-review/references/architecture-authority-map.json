      "id": "explicit_board_decision",
      "status": "available_when_linked_to_exact_decision",
      "authority": "strategy_scope_and_risk_acceptance"
    },
    {
      "id": "approved_product_contract",
      "status": "available_when_versioned_or_linked_to_exact_revision",
      "authority": "product_intent_personas_outcomes_and_non_goals"
    },
    {
      "id": "versioned_api_or_data_contract",
      "status": "disconnected",
      "authority": "interface_schema_compatibility_and_data_semantics"
    },
    {
      "id": "exact_source_revision",
      "status": "authorized_pending_connection",
      "authority": "implemented_structure_and_behavior_at_that_revision"
    },
    {
      "id": "approved_adr_or_rfc_revision",
      "status": "disconnected",
      "authority": "accepted_architecture_decision_and_tradeoffs"
    },
    {
      "id": "release_and_deployment_evidence",
      "status": "disconnected",
      "authority": "artifact_deployed_to_named_environment"
    },
    {
      "id": "fresh_runtime_evidence",
      "status": "disconnected",
      "authority": "current_behavior_health_and_slo_for_named_environment"
    },
    {
      "id": "public_documentation",
      "status": "public_context_only",
      "authority": "public_claim_only"
    }
  ],
  "domains": [
    {
      "id": "platform_boundary_and_product_ownership",
      "owner": "product-prd-lead",
      "reviewer": "principal-platform-architect",
      "strongestSources": ["explicit_board_decision", "approved_product_contract"],
      "freshness": "exact_decision_or_prd_revision_required",
      "unavailableBehavior": "blocked_on_product_authority"
    },
    {
      "id": "api_compatibility_and_versioning",
      "owner": "principal-platform-architect",
      "reviewer": "independent-code-reviewer",
      "strongestSources": ["versioned_api_or_data_contract", "exact_source_revision"],
      "freshness": "exact_contract_version_and_source_revision_required",
      "unavailableBehavior": "blocked_on_contract_authority"
    },
    {
      "id": "tenancy_data_ownership_and_migrations",
      "owner": "principal-platform-architect",
      "reviewer": "independent-code-reviewer",
      "strongestSources": ["versioned_api_or_data_contract", "exact_source_revision", "approved_adr_or_rfc_revision"],
      "freshness": "exact_schema_migration_and_source_revisions_required",
      "unavailableBehavior": "blocked_on_schema_and_migration_evidence"
    },
    {
      "id": "trust_secrets_privacy_and_audit_boundaries",
      "owner": "engineering-assurance-lead",
      "reviewer": "principal-platform-architect",
      "strongestSources": ["explicit_board_decision", "approved_adr_or_rfc_revision", "exact_source_revision"],
      "freshness": "exact_policy_decision_and_source_revision_required",
      "unavailableBehavior": "blocked_on_security_authority"
    },
    {
      "id": "failure_isolation_retries_ordering_and_recovery",
      "owner": "principal-platform-architect",
      "reviewer": "reliability-incident-engineer",
      "strongestSources": ["approved_adr_or_rfc_revision", "exact_source_revision", "fresh_runtime_evidence"],
      "freshness": "exact_design_revision_plus_environment_scoped_runtime_window_required",
      "unavailableBehavior": "review_static_risk_only_and_mark_runtime_unknown"
    },
    {
      "id": "deployed_topology_and_revision",
      "owner": "reliability-incident-engineer",
      "reviewer": "principal-platform-architect",
      "strongestSources": ["release_and_deployment_evidence", "fresh_runtime_evidence"],
      "freshness": "deployment_identity_and_observation_no_older_than_15_minutes",
      "unavailableBehavior": "deployment_state_unknown"
    },
    {
      "id": "slo_capacity_latency_and_cost",
      "owner": "reliability-incident-engineer",
      "reviewer": "engineering-assurance-lead",
      "strongestSources": ["approved_product_contract", "fresh_runtime_evidence"],
      "freshness": "named_environment_bounded_window_and_current_slo_revision_required",
      "unavailableBehavior": "blocked_on_slo_or_runtime_evidence"
    },
    {
      "id": "public_architecture_claim",
      "owner": "documentation-dx-steward",
      "reviewer": "principal-platform-architect",
      "strongestSources": ["approved_product_contract", "versioned_api_or_data_contract", "release_and_deployment_evidence"],
      "contextSource": "public_documentation",
      "freshness": "retrieve_public_claim_at_review_time_and_compare_to_exact_authority_revision",
      "unavailableBehavior": "blocked_on_comparison_authority_not_confirmed_drift"
    }
  ],
  "conflictResolution": [
    {
      "when": "product_intent_conflicts_with_implementation",
      "preserve": ["approved_product_contract", "exact_source_revision"],
      "decisionOwner": "board",
      "outcome": "record_drift_without_silently_redefining_intent"
    },
    {
      "when": "source_revision_conflicts_with_deployment_evidence",
      "preserve": ["exact_source_revision", "release_and_deployment_evidence"],
      "decisionOwner": "reliability-incident-engineer",
      "outcome": "deployed_revision_unknown_until_double_evidence_matches"
    },
    {
      "when": "public_documentation_conflicts_with_stronger_authority",
      "preserve": ["public_documentation", "stronger_authority"],
      "decisionOwner": "documentation-dx-steward",
      "outcome": "documentation_drift_candidate_pending_owner_confirmation"
    }
  ]
}
