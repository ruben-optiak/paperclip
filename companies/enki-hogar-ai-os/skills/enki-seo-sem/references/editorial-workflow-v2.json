{
  "schema": "enki-editorial-workflow/v2",
  "timezone": "Europe/Madrid",
  "memoryAnchor": {
    "taskSlug": "content-memory-ledger",
    "documentKey": "content-ledger",
    "ledgerSchema": "enki-content-ledger/v1"
  },
  "planningArtifact": {
    "documentKey": "editorial-brief",
    "schema": "enki-editorial-brief/v2",
    "requiresRevisionId": true,
    "candidateFingerprintAlgorithm": "sha256(candidateKey|surfaceType|canonicalUrl sorted lexicographically)",
    "decisionMustTargetExactRevision": true,
    "decisionMustTargetExactValidationRevision": true,
    "decisionMustBeAppliedInNewerRevision": true
  },
  "stages": [
    {
      "key": "research",
      "owner": "growth-manager",
      "documentKey": "editorial-brief",
      "requiresRevisionId": true,
      "dependsOn": null,
      "completionGate": "dated_sources_periods_freshness_coverage_and_history_search_recorded"
    },
    {
      "key": "shortlist",
      "owner": "growth-manager",
      "documentKey": "editorial-brief",
      "requiresRevisionId": true,
      "dependsOn": "research",
      "completionGate": "typed_candidates_scored_and_fingerprinted"
    },
    {
      "key": "candidate_validation",
      "owner": "ecommerce-catalogue-manager",
      "documentKey": "editorial-candidate-validation",
      "requiresRevisionId": true,
      "dependsOn": "shortlist",
      "requiresExactCandidateFingerprint": true,
      "allowsCandidateAdditionsOrOmissions": false,
      "missingInputDisposition": "blocked_not_validated",
      "commercialAuthority": "woocommerce-live",
      "technicalAuthority": "active-approved-support-pack"
    },
    {
      "key": "board_decision",
      "owner": "board",
      "documentKey": "editorial-brief",
      "requiresRevisionId": true,
      "dependsOn": "candidate_validation",
      "mode": "human_only",
      "decisionValues": ["accepted", "accepted_with_conditions", "rejected"],
      "completionGate": "decision_targets_validated_revision_and_is_applied_in_a_newer_editorial_brief_revision",
      "approvalIsMutationAuthority": false
    },
    {
      "key": "draft",
      "owner": "growth-manager",
      "documentKey": "content-draft",
      "requiresRevisionId": true,
      "dependsOn": "board_decision",
      "requiresAcceptedBoardDecision": true,
      "requiresPostDecisionBriefRevision": true
    },
    {
      "key": "review",
      "owner": "ecommerce-catalogue-manager",
      "documentKey": "content-review",
      "requiresRevisionId": true,
      "dependsOn": "draft",
      "missingInputDisposition": "blocked_not_reviewed",
      "zeroClaimsMayPass": false
    },
    {
      "key": "publish",
      "owner": "board",
      "documentKey": null,
      "requiresRevisionId": false,
      "dependsOn": "review",
      "mode": "paperclip_ask_first",
      "connector": "content_publisher",
      "approvalOwner": "board",
      "requiresIdempotencyKey": true,
      "requiresExactReviewedRevision": true
    }
  ],
  "invariants": [
    "A category, brand landing, article and WooCommerce product are different surfaces and identities.",
    "A WordPress post identifier is never a WooCommerce product identifier or SKU.",
    "Candidate validation uses the exact shortlist revision and fingerprint without additions or omissions.",
    "Scores are recomputed from declared weights; a typed total is not trusted.",
    "A Board decision does not complete the gate until a newer editorial-brief revision records it and the next action.",
    "Planning, decisions and approvals do not authorize external writes; publishing remains a separate exact-argument approval."
  ]
}
