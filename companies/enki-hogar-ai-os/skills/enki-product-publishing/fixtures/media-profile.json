{
  "schema": "enki-product-media-profile/v1",
  "profileKey": "enki-square-candidate",
  "version": "1.0.0",
  "source": {
    "allowedMimeTypes": ["image/jpeg", "image/png", "image/webp"],
    "minimumWidth": 800,
    "minimumHeight": 800,
    "rightsConfirmationRequired": true
  },
  "output": {
