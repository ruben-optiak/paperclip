{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enki.invalid/contracts/product-primary-image-policy-v1.schema.json",
  "title": "Enki primary product image policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policyKey", "version", "output", "contentDetection", "sourceClasses"],
  "properties": {
    "schema": {"const": "enki-primary-product-image-policy/v1"},
    "policyKey": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "width", "height", "background", "quality", "method", "stripMetadata"],
      "properties": {
        "format": {"const": "webp"},
        "width": {"type": "integer", "minimum": 256, "maximum": 2400},
        "height": {"type": "integer", "minimum": 256, "maximum": 2400},
        "background": {"const": "#FFFFFF"},
        "quality": {"type": "integer", "minimum": 1, "maximum": 100},
        "method": {"type": "integer", "minimum": 0, "maximum": 6},
        "stripMetadata": {"const": true}
      }
    },
    "contentDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whiteThreshold", "paddingRatio", "targetContentFill"],
      "properties": {
        "whiteThreshold": {"type": "integer", "minimum": 0, "maximum": 50},
        "paddingRatio": {"type": "number", "minimum": 0, "maximum": 0.2},
        "targetContentFill": {"type": "number", "minimum": 0.5, "maximum": 0.9}
      }
    },
    "sourceClasses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official", "pdf-derived"],
      "properties": {
        "official": {"$ref": "#/$defs/sourceClass"},
        "pdf-derived": {"$ref": "#/$defs/sourceClass"}
      }
    }
  },
  "$defs": {
    "sourceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxUpscale"],
      "properties": {
        "maxUpscale": {"type": "number", "minimum": 1, "maximum": 4}
      }
    }
  }
}
