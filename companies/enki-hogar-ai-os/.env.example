# Copy outside the repository; never commit the populated file.
WOO_BASE_URL=https://www.example.invalid
WOO_CONSUMER_KEY=change-me-read-only-key
WOO_CONSUMER_SECRET=change-me-read-only-secret
WOO_MCP_TOKEN=change-me-connector-token

GOOGLE_PROJECT_ID=change-me-project
GOOGLE_ADS_DEVELOPER_TOKEN=change-me-developer-token
# Optional: manager customer ID, ten digits without hyphens. Remove the placeholder and leave empty for direct access.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=0000000000
# Generate independently; this authenticates Paperclip to the local Google MCP proxies.
GOOGLE_MCP_TOKEN=change-me-connector-token

# Store only absolute host paths here, never JSON contents. The OAuth client must
# be a Desktop client. ADC needs analytics.readonly, adwords and cloud-platform;
# the GSC directory must contain tokens.json.
GOOGLE_ADC_HOST_PATH=/absolute/path/to/application-default-credentials.json
GOOGLE_OAUTH_CLIENT_HOST_PATH=/absolute/path/to/oauth-client.json
GSC_TOKEN_HOST_DIR=/absolute/path/to/gsc-token-directory

# Rebuildable product-support knowledge projection. Generate independent random
# values; the MCP receives only the reader password, never the admin password.
SUPPORT_DB_ADMIN_PASSWORD=change-me-admin-password
SUPPORT_DB_READER_PASSWORD=change-me-reader-password
SUPPORT_MCP_TOKEN=change-me-connector-token

# Optional OpenAI-compatible embeddings. Leave all three empty for PostgreSQL
# full-text/trigram retrieval without an external API.
SUPPORT_EMBEDDING_BASE_URL=
SUPPORT_EMBEDDING_API_KEY=
SUPPORT_EMBEDDING_MODEL=

# Governed content publisher. Generate this bearer independently. Keep writes
# disabled until the connection catalog and Paperclip ask-first policies pass
# smoke testing. Provider groups may remain empty.
CONTENT_PUBLISHER_MCP_TOKEN=change-me-connector-token
CONTENT_PUBLISH_WRITE_MODE=disabled

WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Pin the reviewed Meta Graph API version explicitly; never use "latest".
META_GRAPH_API_VERSION=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_INSTAGRAM_GRAPH_BASE_URL=
META_GRAPH_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_USER_ID=
# Telegram intentionally has no environment variable here. Bind its bot token
# from a company-scoped Paperclip Secret in the plugin settings.
