{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enki:editorial-feedback:v1",
  "title": "Enki editorial feedback v1",
  "description": "Versioned, non-PII observations tied to the exact editorial artifact they review. Cross-field gates are enforced by enki-editorial-learning/scripts/validate_editorial_learning.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "timezone", "generated_at", "provenance", "revision", "observations"],
  "properties": {
    "schema": {"const": "enki-editorial-feedback/v1"},
    "timezone": {"const": "Europe/Madrid"},
    "generated_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceIssue", "authority"],
      "properties": {
        "kind": {"enum": ["operational", "sanitized_fixture"]},
        "sourceIssue": {"type": ["string", "null"]},
        "authority": {"const": "recorded_observation_not_automatic_rule"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revisionId", "revisionNumber", "supersedesRevisionId"],
      "properties": {
        "revisionId": {"type": "string", "minLength": 1},
        "revisionNumber": {"type": "integer", "minimum": 1},
        "supersedesRevisionId": {"type": ["string", "null"]}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueKey", "documentKey", "revisionId"],
      "properties": {
        "issueKey": {"type": "string", "minLength": 1},
        "documentKey": {"type": "string", "minLength": 1},
        "revisionId": {"type": "string", "minLength": 1}
      }
    },
    "publicationRef": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "externalId", "canonicalUrl", "publishedAt"],
          "properties": {
            "channel": {"enum": ["blog", "facebook", "instagram", "other"]},
            "externalId": {"type": ["string", "null"]},
            "canonicalUrl": {"type": ["string", "null"], "format": "uri"},
            "publishedAt": {"type": ["string", "null"], "format": "date-time"}
          }
        }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference", "fetchedAt", "periodStart", "periodEnd", "status"],
      "properties": {
        "source": {"enum": ["paperclip", "wordpress", "facebook", "instagram", "woocommerce", "ga4", "gsc", "google_ads", "product_support", "approved_market_source", "operator"]},
        "reference": {"type": "string", "minLength": 1},
        "fetchedAt": {"type": ["string", "null"], "format": "date-time"},
        "periodStart": {"type": ["string", "null"], "format": "date"},
        "periodEnd": {"type": ["string", "null"], "format": "date"},
        "status": {"enum": ["ok", "partial", "unavailable", "not_applicable"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedbackKey", "recordedAt", "source", "subject", "category", "sentiment", "severity", "observation", "suggestedChange", "evidenceRefs", "piiStatus", "status", "lessonCandidate", "supersedesFeedbackKey"],
      "properties": {
        "feedbackKey": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "recordedAt": {"type": "string", "format": "date-time"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorType", "actorRef", "sourceKind", "sourceRef"],
          "properties": {
            "actorType": {"enum": ["board", "agent", "operator", "audience_aggregate", "platform"]},
            "actorRef": {"type": ["string", "null"]},
            "sourceKind": {"enum": ["board_comment", "agent_review", "operator_observation", "anonymized_support_pattern", "platform_signal", "retrospective"]},
            "sourceRef": {"type": "string", "minLength": 1}
          }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentKey", "stage", "artifact", "publication"],
          "properties": {
            "contentKey": {"type": "string", "minLength": 1},
            "stage": {"enum": ["editorial_brief", "draft", "review", "published_content", "retrospective"]},
            "artifact": {"$ref": "#/$defs/artifactRef"},
            "publication": {"$ref": "#/$defs/publicationRef"}
          }
        },
        "category": {"enum": ["factual_accuracy", "brand_tone", "editorial_quality", "duplication", "search_performance", "conversion", "social_engagement", "measurement_quality", "process", "safety", "other"]},
        "sentiment": {"enum": ["positive", "negative", "mixed", "neutral"]},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "observation": {"type": "string", "minLength": 1},
        "suggestedChange": {"type": ["string", "null"]},
        "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "piiStatus": {"const": "none_or_anonymized"},
        "status": {"enum": ["observed", "triaged", "superseded"]},
        "lessonCandidate": {"type": "boolean"},
        "supersedesFeedbackKey": {"type": ["string", "null"]}
      }
    }
  }
}
