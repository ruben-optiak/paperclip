{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enki:evidence-envelope:v1",
  "title": "Enki evidence envelope v1",
  "description": "Canonical boundary for every Enki data source. WooCommerce emits it natively; the Enki normalization layer must wrap raw GA4, GSC and Google Ads responses before any calculation or brief use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "data", "meta"],
  "properties": {
    "schema": {"const": "enki-evidence-envelope/v1"},
    "data": {},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fetched_at", "period_start", "period_end", "timezone", "currency", "currencies", "freshness", "status", "partial", "warnings", "contracts"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "fetched_at": {"type": "string", "format": "date-time"},
        "period_start": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "period_end": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "timezone": {"const": "Europe/Madrid"},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "currencies": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3}$"}, "uniqueItems": true},
        "freshness": {"enum": ["live", "stale", "historical", "unavailable"]},
        "status": {"enum": ["ok", "partial", "unavailable"]},
        "partial": {"type": "boolean"},
        "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "contracts": {
          "type": "array",
          "items": {"type": "string"},
          "contains": {"const": "enki-evidence-envelope/v1"},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ok"}}},
          "then": {"properties": {"partial": {"const": false}, "freshness": {"enum": ["live", "stale", "historical"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "partial"}}},
          "then": {"properties": {"partial": {"const": true}, "warnings": {"minItems": 1}, "freshness": {"enum": ["live", "stale", "historical"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "unavailable"}}},
          "then": {"properties": {"partial": {"const": true}, "freshness": {"const": "unavailable"}, "warnings": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"period_start": {"type": "null"}}},
          "then": {"properties": {"period_end": {"type": "null"}}},
          "else": {"properties": {"period_end": {"type": "string"}}}
        },
        {
          "if": {"properties": {"currencies": {"maxItems": 0}}},
          "then": {"properties": {"currency": {"type": "null"}}}
        },
        {
          "if": {"properties": {"currencies": {"minItems": 2}}},
          "then": {"properties": {"currency": {"type": "null"}}}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"meta": {"properties": {"status": {"const": "unavailable"}}}}},
      "then": {"properties": {"data": {"type": "null"}}}
    }
  ]
}
